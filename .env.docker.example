## Example env file for docker compose
## Copy to `.env` (do NOT commit `.env`)

# Server
PORT=8080
GIN_MODE=release

# Database container credentials (used by go_db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=go_db

# API DB connection string (used by go_api)
DATABASE_URL=postgres://postgres:postgres@go_db:5432/go_db?sslmode=disable

# Auth (required)
JWT_SECRET=change-me

# Safe defaults
AUTO_MIGRATE=false

# CORS (comma-separated exact origins; leave empty to disable CORS)
# CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_ORIGINS=

# Optional email
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
FRONTEND_RESET_PASSWORD_URL=

# Optional avatar storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AVATAR_BUCKET=avatars

# Optional hardening
PASSWORD_PEPPER=

# Port binding (security)
# - default is localhost only
# - set to 0.0.0.0 to expose publicly
HOST_BIND_IP=127.0.0.1

