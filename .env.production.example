## Production environment (Docker)
## IMPORTANT:
## - Do NOT commit real secrets
## - Keep AUTO_MIGRATE=false in production (prefer migrations)

# Server
PORT=8080

# Database (managed Postgres)
# Examples:
# - postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
# - postgres://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require

# Auth
JWT_SECRET=CHANGE_ME__LONG_RANDOM_SECRET

# Safety: never run schema changes at runtime in serverless
AUTO_MIGRATE=false

# CORS: comma-separated allowlist of exact origins (no trailing slash).
# Example:
# CORS_ALLOW_ORIGINS=https://self-dojo-web.vercel.app,https://app.selfdojo.com
CORS_ALLOW_ORIGINS=https://YOUR_FRONTEND_DOMAIN

# Email (optional; if empty, forgot-password returns token in response)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
FRONTEND_RESET_PASSWORD_URL=https://YOUR_FRONTEND_DOMAIN/redefinir-senha?token=

# Avatar upload (optional)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AVATAR_BUCKET=avatars

# Optional hardening (if your code uses it)
PASSWORD_PEPPER=

